--- /dev/null
+++ b/packages/core/src/renderables/EmbeddedTerminalInput.ts
@@ -0,0 +1,71 @@
+import type { EmbeddedTerminalKey, EmbeddedTerminalMouse } from "../zig.js"
+
+export type EmbeddedTerminalInputEvent =
+  | { readonly kind: "key"; readonly key: Readonly<EmbeddedTerminalKey> }
+  | { readonly kind: "paste"; readonly byteLength: number }
+  | {
+      readonly kind: "mouse"
+      readonly mouse: Readonly<EmbeddedTerminalMouse>
+      readonly scrollDirection?: "up" | "down" | "left" | "right"
+    }
+  | { readonly kind: "focus"; readonly focused: boolean }
+
+/** Caller-owned, one-shot encoding against the same live terminal's current modes. */
+export type EmbeddedTerminalInputRequest = {
+  readonly event: EmbeddedTerminalInputEvent
+  readonly payloadBytes: number
+  resume(send: (bytes: Uint8Array) => void): void
+  cancel(): void
+}
+
+/** Resolve synchronously or retain in a bounded caller queue; automatic replies bypass this hook. */
+export type EmbeddedTerminalInputAdmission = (request: EmbeddedTerminalInputRequest) => void
+
+/** Internal controller separates admission/accounting from the mutable payload's lifetime copy. */
+export function createEmbeddedTerminalInputRequest(
+  event: EmbeddedTerminalInputEvent,
+  payloadBytes: number,
+  run: (send: (bytes: Uint8Array) => void) => void,
+  retainPayload?: () => void,
+): { request: EmbeddedTerminalInputRequest; retain(): void } {
+  let action: typeof run | undefined = run
+  let retainAction = retainPayload
+  let retained = false
+  const descriptor = Object.freeze(
+    event.kind === "key"
+      ? { ...event, key: Object.freeze({ ...event.key }) }
+      : event.kind === "mouse"
+        ? { ...event, mouse: Object.freeze({ ...event.mouse }) }
+        : { ...event },
+  )
+
+  function cancel(): void {
+    action = undefined
+    retainAction = undefined
+  }
+
+  return {
+    request: Object.freeze({
+      event: descriptor,
+      payloadBytes,
+      cancel,
+      resume(send: (bytes: Uint8Array) => void): void {
+        const next = action
+        cancel()
+        next?.(send)
+      },
+    }),
+    retain(): void {
+      if (!action || retained) return
+      retained = true
+      const copy = retainAction
+      retainAction = undefined
+      try {
+        copy?.()
+      } catch (error) {
+        cancel()
+        throw error
+      }
+    },
+  }
+}
