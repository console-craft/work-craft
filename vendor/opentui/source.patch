--- /dev/null
+++ b/packages/core/src/renderables/EmbeddedTerminalInput.test.ts
@@ -0,0 +1,267 @@
+import { afterEach, beforeEach, describe, expect, test } from "bun:test"
+import { KeyEvent, PasteEvent } from "../lib/KeyHandler.js"
+import { parseKeypress } from "../lib/parse.keypress.js"
+import { createTestRenderer, type TestRendererSetup } from "../testing/test-renderer.js"
+import { EmbeddedTerminalRenderable } from "./EmbeddedTerminal.js"
+import { createEmbeddedTerminalInputRequest, type EmbeddedTerminalInputRequest } from "./EmbeddedTerminalInput.js"
+
+const decode = (bytes: Uint8Array) => new TextDecoder().decode(bytes)
+
+describe("embedded terminal input admission", () => {
+  let setup: TestRendererSetup
+  let terminal: EmbeddedTerminalRenderable
+  let pending: EmbeddedTerminalInputRequest[]
+  let immediate: string[]
+
+  beforeEach(async () => {
+    setup = await createTestRenderer({ width: 30, height: 8 })
+    pending = []
+    immediate = []
+    terminal = new EmbeddedTerminalRenderable(setup.renderer, {
+      width: 20,
+      height: 4,
+      onInputAdmission: (request) => pending.push(request),
+      onData: (bytes, source) => immediate.push(`${source}:${decode(bytes)}`),
+    })
+    setup.renderer.root.add(terminal)
+  })
+
+  afterEach(() => setup.renderer.destroy())
+
+  test("uses parsed modes and the original sink", () => {
+    const original: string[] = []
+    terminal.handleKeyPress(new KeyEvent(parseKeypress("\x1b[A")!))
+    expect(pending).toHaveLength(1)
+    expect(immediate).toEqual([])
+    terminal.write("\x1b[?1h")
+    terminal.onData = () => {
+      throw new Error("borrowed a later sender")
+    }
+    pending[0]!.resume((bytes) => original.push(decode(bytes)))
+    expect(original).toEqual(["\x1bOA"])
+  })
+
+  test("snapshots paste after charging and before the source mutates", () => {
+    const bytes = new TextEncoder().encode("original")
+    terminal.handlePaste(new PasteEvent(bytes))
+    expect(pending).toHaveLength(1)
+    expect(pending[0]!.payloadBytes).toBe(8)
+    bytes.fill(120)
+    terminal.write("\x1b[?2004h")
+    pending[0]!.resume((value) => immediate.push(decode(value)))
+    expect(immediate).toEqual(["\x1b[200~original\x1b[201~"])
+  })
+
+  test("settles before a reentrant sink and only sends once", () => {
+    terminal.handlePaste(new PasteEvent(new TextEncoder().encode("once")))
+    expect(pending).toHaveLength(1)
+    const request = pending[0]!
+    const output: string[] = []
+    request.resume((bytes) => {
+      output.push(decode(bytes))
+      request.resume(() => output.push("reentrant"))
+    })
+    request.resume(() => output.push("twice"))
+    request.cancel()
+    expect(output).toEqual(["once"])
+  })
+
+  test("cancelled requests cannot resume", () => {
+    terminal.handlePaste(new PasteEvent(new TextEncoder().encode("cancelled")))
+    expect(pending).toHaveLength(1)
+    pending[0]!.cancel()
+    pending[0]!.cancel()
+    pending[0]!.resume(() => immediate.push("stale"))
+    expect(immediate).toEqual([])
+  })
+
+  test("cancelled admission does not copy a rejected paste", () => {
+    let copies = 0
+    class CountedBytes extends Uint8Array {
+      override slice(start?: number, end?: number): Uint8Array<ArrayBuffer> {
+        copies++
+        return super.slice(start, end)
+      }
+    }
+    terminal.onInputAdmission = (request) => request.cancel()
+    terminal.handlePaste(new PasteEvent(new CountedBytes([97])))
+    expect(copies).toBe(0)
+    expect(immediate).toEqual([])
+  })
+
+  test("retained admission makes exactly one lifetime copy after the callback", () => {
+    const order: string[] = []
+    class CountedBytes extends Uint8Array {
+      override slice(start?: number, end?: number): Uint8Array<ArrayBuffer> {
+        order.push("copy")
+        return super.slice(start, end)
+      }
+    }
+    terminal.onInputAdmission = (request) => {
+      order.push("charged")
+      pending.push(request)
+    }
+    terminal.handlePaste(new PasteEvent(new CountedBytes([97])))
+    expect(order).toEqual(["charged", "copy"])
+    pending[0]!.resume((bytes) => immediate.push(decode(bytes)))
+    expect(order).toEqual(["charged", "copy"])
+    expect(immediate).toEqual(["a"])
+  })
+
+  test("destruction inside admission cancels before copying its paste", () => {
+    let copies = 0
+    class CountedBytes extends Uint8Array {
+      override slice(start?: number, end?: number): Uint8Array<ArrayBuffer> {
+        copies++
+        return super.slice(start, end)
+      }
+    }
+    terminal.onInputAdmission = (request) => {
+      pending.push(request)
+      terminal.destroy()
+    }
+    terminal.handlePaste(new PasteEvent(new CountedBytes([97])))
+    expect(copies).toBe(0)
+    pending[0]!.resume(() => immediate.push("stale"))
+    expect(immediate).toEqual([])
+  })
+
+  test("failed paste retention cancels the request and releases its action", () => {
+    class FailingBytes extends Uint8Array {
+      override slice(): never {
+        throw new Error("lifetime copy failed")
+      }
+    }
+    expect(() => terminal.handlePaste(new PasteEvent(new FailingBytes([97])))).toThrow("lifetime copy failed")
+    expect(pending).toHaveLength(1)
+    pending[0]!.resume(() => immediate.push("stale"))
+    expect(immediate).toEqual([])
+  })
+
+  test("controller retention is idempotent and cancellation never retains", () => {
+    let copies = 0
+    const first = createEmbeddedTerminalInputRequest(
+      { kind: "paste", byteLength: 1 },
+      1,
+      (send) => send(new Uint8Array([97])),
+      () => {
+        copies++
+      },
+    )
+    first.retain()
+    first.retain()
+    first.request.resume((bytes) => immediate.push(decode(bytes)))
+    first.retain()
+    const second = createEmbeddedTerminalInputRequest(
+      { kind: "paste", byteLength: 1 },
+      1,
+      () => {
+        throw new Error("cancelled")
+      },
+      () => {
+        copies++
+      },
+    )
+    second.request.cancel()
+    second.retain()
+    expect(copies).toBe(1)
+    expect(immediate).toEqual(["a"])
+  })
+
+  test("an encoder failure settles the request before propagating", () => {
+    let encodes = 0
+    const controller = createEmbeddedTerminalInputRequest({ kind: "focus", focused: true }, 0, () => {
+      encodes++
+      throw new Error("encode failed")
+    })
+    expect(() => controller.request.resume(() => {})).toThrow("encode failed")
+    controller.request.resume(() => immediate.push("stale"))
+    expect(encodes).toBe(1)
+    expect(immediate).toEqual([])
+  })
+
+  test("focus transfer and release listeners do not wait for reports", () => {
+    terminal.focus()
+    expect(terminal.focused).toBe(true)
+    expect(setup.renderer.currentFocusedRenderable).toBe(terminal)
+    expect(pending.map((request) => request.event.kind)).toEqual(["focus"])
+    const release = parseKeypress("\x1b[97;1:3u", { useKittyKeyboard: true })!
+    setup.renderer.keyInput.processParsedKey(release)
+    expect(pending).toHaveLength(2)
+    terminal.blur()
+    expect(terminal.focused).toBe(false)
+    expect(setup.renderer.currentFocusedRenderable).not.toBe(terminal)
+    setup.renderer.keyInput.processParsedKey(release)
+    expect(pending).toHaveLength(3)
+    terminal.write("\x1b[?1004h\x1b[>3u")
+    for (const request of pending) {
+      request.resume((bytes) => immediate.push(decode(bytes)))
+    }
+    expect(immediate).toEqual(["\x1b[I", "\x1b[97;1:3u", "\x1b[O"])
+    expect(terminal.focused).toBe(false)
+  })
+
+  test.each(["remove", "destroy"] as const)("%s invalidates pending requests without retaining focus", (action) => {
+    terminal.focus()
+    terminal.handlePaste(new PasteEvent(new TextEncoder().encode("stale")))
+    if (action === "remove") {
+      setup.renderer.root.remove(terminal)
+      setup.renderer.root.add(terminal)
+    } else {
+      terminal.destroy()
+    }
+    expect(terminal.focused).toBe(false)
+    expect(setup.renderer.currentFocusedRenderable).not.toBe(terminal)
+    for (const request of pending) {
+      request.resume(() => immediate.push("stale"))
+    }
+    expect(immediate).toEqual([])
+  })
+
+  test("automatic replies bypass held input admission", () => {
+    terminal.handlePaste(new PasteEvent(new TextEncoder().encode("held")))
+    terminal.write("\x1b[5n")
+    expect(pending).toHaveLength(1)
+    expect(immediate).toEqual(["response:\x1b[0n"])
+  })
+
+  test("a throwing admission callback cancels its request", () => {
+    let retained: EmbeddedTerminalInputRequest | undefined
+    terminal.onInputAdmission = (request) => {
+      retained = request
+      throw new Error("admission failed")
+    }
+    expect(() => terminal.handlePaste(new PasteEvent(new Uint8Array([97])))).toThrow("admission failed")
+    expect(retained).toBeDefined()
+    retained!.resume(() => immediate.push("stale"))
+    expect(immediate).toEqual([])
+  })
+
+  test("a throwing sink remains settled without changing focus", () => {
+    terminal.focus()
+    terminal.handlePaste(new PasteEvent(new Uint8Array([97])))
+    expect(pending).toHaveLength(2)
+    expect(() =>
+      pending[1]!.resume(() => {
+        throw new Error("sink failed")
+      }),
+    ).toThrow("sink failed")
+    pending[1]!.resume(() => immediate.push("duplicate"))
+    expect(immediate).toEqual([])
+    expect(terminal.focused).toBe(true)
+  })
+
+  test.each([
+    ["Unicode", "λ", "", "λ"],
+    ["Dvorak press", "\x1b[117::102;5u", "\x1b[>3u", "\x1b[117;5u"],
+    ["Dvorak repeat", "\x1b[117::102;5:2u", "\x1b[>3u", "\x1b[117;5:2u"],
+    ["Dvorak release", "\x1b[117::102;5:3u", "\x1b[>3u", "\x1b[117;5:3u"],
+    ["base layout", "\x1b[117::102;5u", "\x1b[>5u", "\x1b[117::102;5u"],
+  ])("normalization preserves %s", (_label, raw, modes, expected) => {
+    terminal.handleKeyPress(new KeyEvent(parseKeypress(raw, { useKittyKeyboard: true })!))
+    expect(pending).toHaveLength(1)
+    terminal.write(modes)
+    pending[0]!.resume((bytes) => immediate.push(decode(bytes)))
+    expect(immediate).toEqual([expected])
+  })
+})
