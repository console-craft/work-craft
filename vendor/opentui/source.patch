+import { expect, test } from "bun:test"
+import { toArrayBuffer } from "../platform/ffi.js"
+import { getLinkId } from "../utils.js"
+import { resolveRenderLib } from "../zig.js"
+
+test("embedded terminal material resolves its exact OSC8 URL inside a public buffer lease", () => {
+  const lib = resolveRenderLib()
+  const context = lib.createContext({ objectCapacity: 8, renderCellsMax: 36 })
+  const terminal = lib.createContextEmbeddedTerminal(context, { cols: 12, rows: 3 })
+  const target = lib.createContextBuffer(context, { width: 12, height: 3 })
+  try {
+    lib.contextEmbeddedTerminalWrite(context, terminal, "\x1b]8;;https://example.test/λ\x1b\\L\x1b]8;;\x1b\\")
+    lib.contextEmbeddedTerminalCompose({ context, target, frame: null }, terminal, 0, 0)
+    const lease = lib.contextAcquireBufferLease(context, target)
+    try {
+      const attributes = new Uint32Array(toArrayBuffer(lease.attributes, 0, 36 * 4))
+      const id = getLinkId(attributes[0]!)
+      expect(id).not.toBe(0)
+      expect(lib.contextGetLinkUrl(context, id)).toBe("https://example.test/λ")
+      const bytes = new Uint8Array(lib.contextBufferLeaseGetRealCharSize(context, lease.handle, false))
+      lib.contextBufferLeaseWriteResolvedChars(context, lease.handle, bytes, false)
+      expect(new TextDecoder().decode(bytes).startsWith("L")).toBe(true)
+    } finally {
+      lib.contextReleaseBufferLease(context, lease.handle)
+    }
+  } finally {
+    lib.destroyContextBuffer(context, target)
+    lib.destroyContextEmbeddedTerminal(context, terminal)
+    lib.destroyContext(context)
+  }
+})
