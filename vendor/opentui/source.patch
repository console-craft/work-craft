+/// Borrow only immediately after update, while the terminal cannot change.
+pub fn cellHyperlink(state: *const RenderState, x: usize, y: usize) ?[]const u8 {
+    if (x >= state.cols or y >= state.rows) return null;
+    const pin = state.row_data.slice().items(.pin)[y];
+    const page = pin.node.page();
+    const cell = page.getRowAndCell(x, pin.y).cell;
+    if (!cell.hyperlink) return null;
+    const id = page.lookupHyperlink(cell) orelse return null;
+    return page.hyperlink_set.get(page.memory, id).uri.slice(page.memory);
+}
