+import assert from "node:assert/strict"
+import { execFileSync } from "node:child_process"
+import { mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs"
+import { tmpdir } from "node:os"
+import { dirname, join, resolve } from "node:path"
+import { fileURLToPath } from "node:url"
+
+const root = resolve(dirname(fileURLToPath(import.meta.url)), "..")
+const nativeName = `@opentui/core-${process.platform}-${process.arch}`
+const core = resolve(root, "../core")
+const version = "0.6.6-workcraft.1"
+const directory = mkdtempSync(join(tmpdir(), "opentui-react-contract-"))
+
+function pack(path: string): string {
+  const metadata = JSON.parse(readFileSync(join(path, "package.json"), "utf8"))
+  assert.equal(metadata.version, version, "Packed React contract versions must match")
+  execFileSync("bun", ["pm", "pack", "--destination", directory], { cwd: path, stdio: "pipe" })
+  return join(directory, `${metadata.name.slice(1).replace("/", "-")}-${version}.tgz`)
+}
+
+try {
+  const dependencies = {
+    "@opentui/core": pack(join(core, "dist")),
+    "@opentui/react": pack(join(root, "dist")),
+    [nativeName]: pack(join(core, "node_modules", nativeName)),
+    react: ">=19.2.0",
+  }
+  writeFileSync(
+    join(directory, "package.json"),
+    JSON.stringify({
+      name: "opentui-react-contract-consumer",
+      private: true,
+      type: "module",
+      dependencies,
+      overrides: { "@opentui/core": dependencies["@opentui/core"], [nativeName]: dependencies[nativeName] },
+      devDependencies: { typescript: "^5", "@types/react": "^19.2.0", "@types/bun": "1.4.1" },
+    }),
+  )
+  writeFileSync(
+    join(directory, "tsconfig.json"),
+    JSON.stringify({
+      compilerOptions: {
+        target: "ESNext",
+        module: "ESNext",
+        moduleResolution: "Bundler",
+        jsx: "react-jsx",
+        jsxImportSource: "@opentui/react",
+        strict: true,
+        skipLibCheck: true,
+        noEmit: true,
+      },
+      include: ["consumer.tsx"],
+    }),
+  )
+  writeFileSync(
+    join(directory, "consumer.tsx"),
+    String.raw`
+import { EmbeddedTerminalRenderable, KeyEvent, type EmbeddedTerminalInputRequest } from "@opentui/core"
+import { extend } from "@opentui/react"
+import { testRender } from "@opentui/react/test-utils"
+declare module "@opentui/react" {
+  interface OpenTUIComponents { terminal: typeof EmbeddedTerminalRenderable }
+}
+extend({ terminal: EmbeddedTerminalRenderable })
+const ref: { current: EmbeddedTerminalRenderable | null } = { current: null }
+const pending: EmbeddedTerminalInputRequest[] = []
+const setup = await testRender(<terminal cols={12} rows={3}
+  ref={(node) => { ref.current = node }} onInputAdmission={(request) => pending.push(request)} />,
+  { width: 12, height: 3 })
+try {
+  if (!(ref.current instanceof EmbeddedTerminalRenderable)) throw new Error("React loaded a different core instance")
+  ref.current.handleKeyPress(new KeyEvent({ name: "up", sequence: "\x1b[A", raw: "\x1b[A",
+    ctrl: false, meta: false, shift: false, option: false, number: false, eventType: "press", source: "raw" }))
+  if (pending.length !== 1) throw new Error("React lost admission prop")
+  ref.current.write("\x1b[?1h")
+  let encoded = ""
+  pending[0]!.resume((bytes) => { encoded = new TextDecoder().decode(bytes) })
+  if (encoded !== "\x1bOA") throw new Error("React encoded input before modes")
+} finally {
+  setup.renderer.destroy()
+  await setup.renderer.closed
+}
+console.log("Packed React terminal contract passed")
+`,
+  )
+  execFileSync("bun", ["install", "--ignore-scripts"], { cwd: directory, stdio: "inherit" })
+  execFileSync("bun", ["x", "tsc", "--noEmit"], { cwd: directory, stdio: "inherit" })
+  execFileSync("bun", ["consumer.tsx"], { cwd: directory, stdio: "inherit" })
+} finally {
+  rmSync(directory, { recursive: true, force: true })
+}
