{
  "name": "work-craft",
  "version": "1.1.0",
  "private": true,
  "description": "A Bun workspace for the Work Craft server, terminal UI, and CLI.",
  "homepage": "https://github.com/console-craft/work-craft#readme",
  "bugs": {
    "url": "https://github.com/console-craft/work-craft/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Ovi Ispas",
    "email": "ovi@console-craft.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/console-craft/work-craft.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun  --watch src/main.ts",
    "db:seed": "bun scripts/seed.ts",
    "build": "mkdir -p dist && bun build --compile src/main.ts --outfile dist/work-craft",
    "build:install": "bun run build && sh scripts/install.sh",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run test:core",
    "check:all": "bun run lint && bun run format:check && bun run typecheck && bun run test:all && bun run build && bun run test:smoke",
    "cli": "bun src/main.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --no-error-on-unmatched-pattern .",
    "lint:fix": "oxlint --fix .",
    "prepare": "lefthook install",
    "server": "bun src/main.ts __daemon",
    "test": "bun scripts/test-gates.ts core",
    "test:core": "bun scripts/test-gates.ts core",
    "test:acceptance": "bun scripts/test-gates.ts acceptance",
    "test:tooling": "bun scripts/test-gates.ts tooling",
    "test:all": "bun scripts/test-gates.ts all",
    "test:smoke": "bun scripts/run-bounded.ts 60000 bun scripts/smoke-build.ts",
    "tui": "bun src/main.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/bun": "^1.4.2",
    "lefthook": "^2.1.14",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.83.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.4"
}
