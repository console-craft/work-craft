{
  "name": "work-craft",
  "version": "0.0.0",
  "private": true,
  "description": "A Bun workspace for the Work Craft server, terminal UI, and CLI.",
  "homepage": "https://github.com/console-craft/work-craft#readme",
  "bugs": {
    "url": "https://github.com/console-craft/work-craft/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Ovi Ispas",
    "email": "ovi@console-craft.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/console-craft/work-craft.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run test",
    "cli": "bun run --filter @work-craft/cli start",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --no-error-on-unmatched-pattern .",
    "prepare": "lefthook install",
    "server": "bun run --filter @work-craft/server start",
    "test": "bun test --pass-with-no-tests",
    "tui": "bun run --filter @work-craft/tui start",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/bun": "^1.4.2",
    "lefthook": "^2.1.14",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.2"
}
