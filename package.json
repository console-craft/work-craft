{
  "name": "work-craft",
  "version": "1.1.0",
  "private": true,
  "description": "A Bun workspace for the Work Craft server, terminal UI, and CLI.",
  "homepage": "https://github.com/console-craft/work-craft#readme",
  "bugs": {
    "url": "https://github.com/console-craft/work-craft/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Ovi Ispas",
    "email": "ovi@console-craft.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/console-craft/work-craft.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "benchmark:output": "bun test ./packages/tui/src/tests/output-profile.benchmark.ts",
    "dev": "bun  --watch src/main.ts",
    "diagnose:hyperlinks": "bun test ./packages/server/src/terminal/tests/projection-feasibility.diagnostic.ts ./packages/tui/src/workbench/tests/native-contract.diagnostic.ts ./packages/tui/src/workbench/tests/projection-feasibility.diagnostic.tsx",
    "build": "mkdir -p dist && bun build --compile src/main.ts --outfile dist/work-craft",
    "build:install": "bun run build && sh scripts/install.sh",
    "build:smoke": "bun scripts/smoke-build.ts",
    "preview:build": "bun scripts/build-preview.ts",
    "preview:smoke": "bun scripts/smoke-preview.ts",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run test && bun run build && bun run build:smoke",
    "cli": "bun src/main.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --no-error-on-unmatched-pattern .",
    "lint:fix": "oxlint --fix .",
    "prepare": "lefthook install",
    "server": "bun src/main.ts __daemon",
    "test": "bun test",
    "tui": "bun src/main.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/bun": "^1.4.2",
    "lefthook": "^2.1.14",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.83.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.3"
}
