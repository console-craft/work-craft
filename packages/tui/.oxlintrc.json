{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "src/components/ui/**",
    "src/hooks/use-theme.ts",
    "src/lib/terminal-themes/**",
    "src/providers/theme-provider.tsx"
  ],
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "@work-craft/server",
            "message": "Import client-safe APIs from @work-craft/server/client."
          }
        ]
      }
    ]
  }
}
