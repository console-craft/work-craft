{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "rules": {
    "sort-imports": [
      "error",
      {
        "ignoreDeclarationSort": true,
        "ignoreCase": true
      }
    ],

    "no-unused-vars": [
      "error",
      {
        "args": "all",
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_",
        "destructuredArrayIgnorePattern": "^_",
        "fix": {
          "imports": "safe-fix",
          "variables": "off"
        }
      }
    ]
  }
}
